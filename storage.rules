rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidAPK() {
      return request.resource.size < 120 * 1024 * 1024 && // Max 120MB
             (request.resource.contentType == 'application/vnd.android.package-archive' ||
              request.resource.contentType == 'application/octet-stream');
    }

    // User input files
    match /users/{userId}/inputs/{jobId}/{fileName} {
      // Users can upload their own APKs
      allow create: if isOwner(userId) && isValidAPK();

      // Users can read their own files
      allow read: if isOwner(userId);

      // No updates or deletes
      allow update, delete: if false;
    }

    // User output files
    match /users/{userId}/outputs/{jobId}/{fileName} {
      // Users can read their own protected APKs
      allow read: if isOwner(userId);

      // Only system can create/update/delete output files
      allow create, update, delete: if false;
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
