# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloud Run Configuration
NEXT_PUBLIC_CLOUD_RUN_URL=https://your-service-xxxxx-uc.a.run.app
